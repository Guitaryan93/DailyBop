# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
venv/
.env/

# Environment variables
.env

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# System files
.DS_Store
Thumbs.db

# Logs
*.log

# Documentation to ignore
docs.txt

# Project Database should NEVER be on GitHub Repo
database/
database.db

# Scripts used for publishing the site should not be public
# They contain sensitive login data for my Neocities site
scripts/upload.sh
scripts/update_dailybop.sh

# Stop tracking Vim swap files
.*.sw[a-z]

# Ignore ssl certs for testing environment
*.pem

# Ignore the neocities image file
neocities.png

# Ignore dev server script
scripts/dev_server.sh

# No secrets allowed
secrets.*
oauth.json
browser.json
